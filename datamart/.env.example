# Copy to .env and set the passwords for the local PostgreSQL server.
POSTGRES_PASSWORD=
DATAMART_DB_PORT=5440

# MCP server: the read-only database role's password and the demo user. The demo user only applies with
# sign-in off (OAUTH_ISSUER set to empty). The server is on port 3000 and Keycloak on 8443; the ports are
# fixed because the Keycloak realm and the tokens refer to them.
MCP_READER_PASSWORD=
DEMO_USER_EMAIL=tina.blevins@RidgemontHighSchool.edu
# OAUTH_ISSUER=

# Sign-in (Keycloak): the admin password and the demo users' password.
KEYCLOAK_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
