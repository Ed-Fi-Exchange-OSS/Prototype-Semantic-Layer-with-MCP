# Copy to .env and set the passwords for the local PostgreSQL server.
POSTGRES_PASSWORD=
DATAMART_DB_PORT=5440

# MCP server: the read-only database role's password, the demo user and the port. The demo user only
# applies with sign-in off (OAUTH_ISSUER set to empty).
MCP_READER_PASSWORD=
DEMO_USER_EMAIL=tina.blevins@RidgemontHighSchool.edu
MCP_PORT=3000
# OAUTH_ISSUER=

# Sign-in (Keycloak): the admin password, the demo users' password and the port.
KEYCLOAK_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
KEYCLOAK_PORT=8443
